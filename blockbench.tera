---
whiskers:
  version: ^2.5.1
  filename: "themes/catppuccin.bbtheme"
  hex_format: "#{{r}}{{g}}{{b}}"
---
/*
name: Catppuccin
author: Catppuccin
borders: false
options:
  flavor:
    name: Flavor
    options:
      latte: Latte
      frappe: Frappé
      macchiato: Macchiato
      mocha: Mocha
  accent:
    name: Accent
    options:
      {%- for flavorId, flavor in flavors %}{%- if loop.last %}
      {%- for colorId, color in flavor.colors %}{%- if color.accent %}
      {{ colorId }}: {{color.name}}
      {%- endif %}{%- endfor %}
      {%- endif %}{%- endfor %}
*/

{%- for flavorId, flavor in flavors %}
{% if loop.last %}body,{% endif %}
[theme-flavor="{{ flavorId }}"] {
  --color-ui: {{ flavor.colors.base.hex }};
  --color-back: {{ flavor.colors.mantle.hex }};
  --color-dark: {{ flavor.colors.crust.hex }};
  --color-border: {{ flavor.colors.overlay0.hex }};
  --color-selected: {{ flavor.colors.surface1.hex }};
  --color-elevated: {{ flavor.colors.surface0.hex }};
  --color-button: {{ flavor.colors.surface0.hex }};
  --color-bright_ui: {{ flavor.colors.text.hex }};
  --color-frame: {{ flavor.colors.mantle.hex }};
  --color-text: {{ flavor.colors.subtext1.hex }};
  --color-light: {{ flavor.colors.text.hex }};
  --color-accent_text: {{ flavor.colors.base.hex }};
  --color-bright_ui_text: {{ flavor.colors.base.hex }};
  --color-subtle_text: {{ flavor.colors.subtext0.hex }};
  --color-grid: {{ flavor.colors.subtext0.hex }};
  --color-wireframe: {{ flavor.colors.subtext0.hex }};
  --color-checkerboard: {{ flavor.colors.surface1.hex }};
  {%- if loop.last %}
  --color-accent: {{ flavor.colors.mauve.hex }};
  {%- endif %}
}
{%- for colorId, color in flavor.colors %}{% if color.accent %}
[theme-flavor="{{ flavorId }}"][theme-accent="{{ colorId }}"] {
  --color-accent: {{ color.hex }};
}
{%- endif %}{%- endfor %}
{%- endfor %}
