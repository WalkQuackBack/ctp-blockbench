body {
	--color-ui: #24273a;
	--color-back: #1e2030;
	--color-dark: #181926;
	--color-border: #6e738d;
	--color-selected: #494d64;
	--color-elevated: #363a4f;
	--color-button: #363a4f;
	--color-bright_ui: #cad3f5;
	--color-accent: #8aadf4;
	--color-frame: #1e2030;
	--color-text: #b8c0e0;
	--color-light: #cad3f5;
	--color-accent_text: #24273a;
	--color-bright_ui_text: #24273a;
	--color-subtle_text: #a5adcb;
	--color-grid: #a5adcb;
	--color-wireframe: #a5adcb;
	--color-checkerboard: #494d64;
}
