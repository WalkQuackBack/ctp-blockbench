/*
name: Catppuccin Latte Blue
author: Catppuccin
borders: false
*/
body {
	--color-ui: #eff1f5;
	--color-back: #e6e9ef;
	--color-dark: #dce0e8;
	--color-border: #9ca0b0;
	--color-selected: #bcc0cc;
	--color-elevated: #ccd0da;
	--color-button: #ccd0da;
	--color-bright_ui: #4c4f69;
	--color-accent: #1e66f5;
	--color-frame: #e6e9ef;
	--color-text: #5c5f77;
	--color-light: #4c4f69;
	--color-accent_text: #eff1f5;
	--color-bright_ui_text: #eff1f5;
	--color-subtle_text: #6c6f85;
	--color-grid: #6c6f85;
	--color-wireframe: #6c6f85;
	--color-checkerboard: #bcc0cc;
}
