body {
	--color-ui: #303446;
	--color-back: #292c3c;
	--color-dark: #232634;
	--color-border: #737994;
	--color-selected: #51576d;
	--color-elevated: #414559;
	--color-button: #414559;
	--color-bright_ui: #c6d0f5;
	--color-accent: #ef9f76;
	--color-frame: #292c3c;
	--color-text: #b5bfe2;
	--color-light: #c6d0f5;
	--color-accent_text: #303446;
	--color-bright_ui_text: #303446;
	--color-subtle_text: #a5adce;
	--color-grid: #a5adce;
	--color-wireframe: #a5adce;
	--color-checkerboard: #51576d;
}
